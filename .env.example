# OpenEmployee demos read these. Copy to .env and fill in your key:
#   cp .env.example .env
#
# Your Anthropic key drives the real-model demos (finance-pa pays bills with a
# real Claude agent). Without it, those demos fall back to a scripted agent that
# still really executes and really gets governed.
ANTHROPIC_API_KEY=

# Optional: override the model used by the agent demos (default: claude-sonnet-4-6)
# OPENEMPLOYEE_MODEL=claude-sonnet-4-6
